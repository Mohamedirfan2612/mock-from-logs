// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MSW v2 handler generator > generates MSW v2 TypeScript module matching snapshot and requirements 1`] = `
"/**
 * Generated by mock-from-logs
 * MSW v2 Request Handlers
 */
import { http, HttpResponse } from 'msw';

interface MockSampleDef {
  status: number;
  contentType?: string;
  body?: unknown;
}

function createMockResponse(sample: MockSampleDef) {
  if (sample.status === 204 || sample.status === 304) {
    return new HttpResponse(null, { status: sample.status });
  }

  const headers: Record<string, string> = {};
  if (sample.contentType) {
    headers['Content-Type'] = sample.contentType;
  }

  if (sample.body === undefined || sample.body === null) {
    return new HttpResponse(null, { status: sample.status, headers });
  }

  if (typeof sample.body === 'object') {
    return HttpResponse.json(sample.body, { status: sample.status, headers });
  }

  return new HttpResponse(String(sample.body), { status: sample.status, headers });
}

function resolveMockResponse(
  request: Request,
  routePath: string,
  samples: MockSampleDef[],
  rotationState: { index: number },
) {
  const url = new URL(request.url);
  const statusOverrideRaw =
    url.searchParams.get('__mock_status') || request.headers.get('x-mock-status');

  if (statusOverrideRaw) {
    const forcedStatus = Number(statusOverrideRaw);
    if (!Number.isNaN(forcedStatus)) {
      const sample = samples.find((s) => s.status === forcedStatus);
      if (sample) {
        return createMockResponse(sample);
      }
      return HttpResponse.json(
        {
          error: 'Mock status override',
          status: forcedStatus,
          message: \`No sample recorded for status \${forcedStatus} on route \${routePath}\`,
        },
        { status: forcedStatus },
      );
    }
  }

  const twoHundredSamples = samples.filter((s) => s.status >= 200 && s.status < 300);
  const pool = twoHundredSamples.length > 0 ? twoHundredSamples : samples;

  if (pool.length === 0) {
    return new HttpResponse(null, { status: 200 });
  }

  const chosen = pool[rotationState.index % pool.length]!;
  rotationState.index++;
  return createMockResponse(chosen);
}

const routeState_0 = { index: 0 };
const routeSamples_0: MockSampleDef[] = [
  {
    "status": 200,
    "contentType": "application/json",
    "body": {
      "id": 1,
      "name": "Alice"
    }
  },
  {
    "status": 404,
    "contentType": "application/json",
    "body": {
      "error": "Not found"
    }
  }
];

const routeState_1 = { index: 0 };
const routeSamples_1: MockSampleDef[] = [
  {
    "status": 201,
    "contentType": "application/json",
    "body": {
      "created": true
    }
  }
];

export const handlers = [
  http.get('*' + "/users/:id", ({ request }) => {
    return resolveMockResponse(request, "/users/:id", routeSamples_0, routeState_0);
  }),
  http.post('*' + "/users", ({ request }) => {
    return resolveMockResponse(request, "/users", routeSamples_1, routeState_1);
  }),
];
"
`;
